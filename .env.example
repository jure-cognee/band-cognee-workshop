# Copy this file to .env and fill in your own values. Never commit .env.

# Steps 0 to 5. Your OpenAI key. Cognee uses it, and so do the BAND agents in step 6.
LLM_API_KEY=

# Step 6. Leave these two lines as they are.
COGNEE_BASE_URL=http://localhost:8000
COGNEE_BAND_DATASET=checkout_v2

# Step 6.3 fills this in for you: uv run python 06_api_key.py
COGNEE_API_KEY=

# Step 6.1. The ID and API key of your two BAND agents, from https://app.band.ai/agents
BAND_AGENT_A_ID=
BAND_AGENT_A_API_KEY=
BAND_AGENT_B_ID=
BAND_AGENT_B_API_KEY=
